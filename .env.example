# Database URL for local development
# By default, docker-compose exposes MySQL on port 3307 locally
# (SERVICE_NAME_db will be dynamically replaced by setup-env.sh)
DATABASE_URL="mysql://root:password@localhost:3307/SERVICE_NAME_db"

# RabbitMQ URL for local development
# By default, docker-compose exposes RabbitMQ on port 5672 locally
RABBITMQ_URL="amqp://localhost:5672"

# API Port (PORT=3000 will be dynamically replaced by setup-env.sh)
PORT=3000
