generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String   @id @default(uuid())
  orderId   String
  userId    String
  status    String   @default("SENT")
  message   String
  createdAt DateTime @default(now())
}
